# CloudSage Application Configuration
APP_NAME=CloudSage
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Safe Development Mock Mode (Set to true to use realistic mock data without AWS credentials)
AWS_MOCK_MODE=true

# AWS Configuration (Used when AWS_MOCK_MODE=false; credentials can also come from ~/.aws/credentials)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=your_aws_session_token_if_temporary
# AWS_PROFILE=default

# LLM Configuration (OpenAI, Gemini, or local fallback engine)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gpt-4o-mini

# Local Database & RAG Storage
DATABASE_URL=sqlite:///./data/cloudsage.db
VECTOR_STORE_PATH=./data/vector_store

# Currency & Localization (Configurable development exchange rate for USD -> INR conversion)
USD_TO_INR_RATE=85
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
